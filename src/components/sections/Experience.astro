---
import Section from "@/components/Section.astro";
import { work } from "@cv";
---

<Section title="Experiencia">
  <ul>
    {
      work.map(({ name, position, startDate, endDate, highlights }) => {
        const endYear = endDate != null ? endDate : "Actual";

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>{name}</h3>
                  <h4>{position}</h4>
                </div>

                <div>
                  <time datetime={startDate} data-title={startDate}>
                    {startDate}
                  </time>
                  {" – "}
                  <time datetime={endDate} data-title={endDate}>
                    {endYear}
                  </time>
                </div>
              </header>

              <footer>
                <ul class="highlights">
                  {highlights.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  article h3 {
    font-weight: 500;
    font-size: 1.1rem;
    color: #111;
  }
  article h4 {
    font-weight: 400;
    color: #222;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }
  time {
    font-size: 0.85rem;
    color: #555;
  }

  footer .highlights {
    list-style: disc;
    margin: 0;
    color: #555;
    gap: 0.5rem;
    margin-top: 0.5rem;
    margin-left: 1rem;
    padding-left: 0.5rem;
    font-size: 0.85rem;
  }

  @media (max-width: 600px) {
    header {
      flex-direction: column;
      gap: 6px;
      margin-bottom: 6px;
    }
  }
</style>
